# Copy this file to .env. Never commit .env or paste production keys into source.

# Gemini
# Local-only AI. No cloud model/API is required for normal assistant use.
BRAIN_PROVIDER_ORDER=ollama,free_web
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Audio / vision
WAKE_WORDS=jarvis,friday
MICROPHONE_INDEX=
COMMAND_TIMEOUT_SECONDS=8
PHRASE_TIME_LIMIT_SECONDS=12

# Safety: "confirm" prints a local confirmation prompt before any UI action.
# Change to "auto" only after testing in a harmless application.
ACTION_MODE=confirm
PYAUTOGUI_PAUSE_SECONDS=0.15
LLM_MAX_ATTEMPTS=3
LLM_RETRY_SECONDS=2
